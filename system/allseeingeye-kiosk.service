[Unit]
Description=All-Seeing Eye kiosk console (fullscreen UI on the attached display)
After=allseeingeye.service systemd-user-sessions.service
Wants=allseeingeye.service

[Service]
User=ase
# cage = minimal Wayland compositor that runs exactly one fullscreen app.
# The Pi boots straight into the camera console — no desktop, no login screen.
ExecStartPre=/opt/allseeingeye/bin/wait-for-engine.sh
ExecStart=/opt/allseeingeye/bin/kiosk-launch.sh
Restart=always
RestartSec=3
# Give the kiosk the first virtual terminal (replaces getty on tty1).
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
PAMName=login
UtmpIdentifier=tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
